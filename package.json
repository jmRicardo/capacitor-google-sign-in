{
  "name": "capacitor-google-sign-in",
  "version": "1.0.0",
  "description": "Sign in with Google for Capacitor 8 on Android and iOS, with a server-issued nonce",
  "main": "dist/plugin.cjs.js",
  "module": "dist/esm/index.js",
  "types": "dist/esm/index.d.ts",
  "unpkg": "dist/plugin.js",
  "files": [
    "android/src/main/",
    "android/build.gradle",
    "android/consumer-rules.pro",
    "dist/",
    "ios/Sources/",
    "ios/Tests/",
    "Package.swift",
    "CapacitorGoogleSignIn.podspec",
    "CHANGELOG.md"
  ],
  "author": "Juan Manuel Ricardo",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jmRicardo/capacitor-google-sign-in.git"
  },
  "bugs": {
    "url": "https://github.com/jmRicardo/capacitor-google-sign-in/issues"
  },
  "keywords": [
    "capacitor",
    "plugin",
    "native",
    "google",
    "sign-in",
    "nonce"
  ],
  "scripts": {
    "verify": "npm run verify:ios && npm run verify:android && npm run verify:web && npm test",
    "verify:ios": "xcodebuild -scheme CapacitorGoogleSignIn -destination generic/platform=iOS",
    "verify:android": "cd android && ./gradlew clean build test && cd ..",
    "verify:web": "npm run build",
    "lint": "npm run eslint && npm run prettier -- --check && npm run swiftlint -- lint",
    "fmt": "npm run eslint -- --fix && npm run prettier -- --write && npm run swiftlint -- --fix --format",
    "eslint": "eslint . --ext ts",
    "prettier": "prettier \"**/*.{css,html,ts,js,java}\" --plugin=prettier-plugin-java",
    "swiftlint": "node-swiftlint",
    "docgen": "docgen --api GoogleSignInPlugin --output-readme README.md --output-json dist/docs.json",
    "build": "npm run clean && npm run docgen && tsc && rollup -c rollup.config.mjs",
    "clean": "rimraf ./dist",
    "watch": "tsc --watch",
    "prepublishOnly": "npm run build",
    "test": "node --test \"test/**/*.test.mjs\""
  },
  "devDependencies": {
    "@capacitor/android": "8.5.2",
    "@capacitor/core": "8.5.2",
    "@capacitor/docgen": "0.3.1",
    "@capacitor/ios": "8.5.2",
    "@ionic/eslint-config": "0.4.0",
    "@ionic/prettier-config": "4.0.0",
    "@ionic/swiftlint-config": "2.0.0",
    "eslint": "8.57.1",
    "prettier": "3.9.6",
    "prettier-plugin-java": "2.10.3",
    "rimraf": "6.1.3",
    "rollup": "4.62.3",
    "swiftlint": "2.0.0",
    "typescript": "5.1.6"
  },
  "peerDependencies": {
    "@capacitor/core": "^8.0.0"
  },
  "prettier": "@ionic/prettier-config",
  "swiftlint": "@ionic/swiftlint-config",
  "eslintConfig": {
    "extends": "@ionic/eslint-config/recommended"
  },
  "capacitor": {
    "ios": {
      "src": "ios"
    },
    "android": {
      "src": "android"
    }
  }
}
